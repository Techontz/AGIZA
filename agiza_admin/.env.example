# Django REST API base URL. Server-side only: never exposed to the browser.
# Production: DJANGO_API_URL=https://agizastore.xyz/api
DJANGO_API_URL=http://127.0.0.1:8000/api

# Auth cookies get the Secure flag automatically in production builds (NODE_ENV=production).
# Leave this unset in production. Set it to "false" only to run a production build over plain http locally.
# SESSION_COOKIE_SECURE=false
