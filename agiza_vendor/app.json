{
  "expo": {
    "name": "AGIZA Seller",
    "slug": "agiza-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agiza-seller",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "tz.co.agiza.seller",
      "supportsTablet": false
    },
    "android": {
      "package": "tz.co.agiza.seller",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AGIZA Seller uses your photos for product pictures and your store logo and banner.",
          "cameraPermission": "AGIZA Seller uses the camera to photograph your products and your store logo and banner.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E25805",
          "defaultChannel": "seller"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
