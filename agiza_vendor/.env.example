# AGIZA Seller app configuration. Copy to .env (never commit .env).
#
# EXPO_PUBLIC_API_URL: base URL of the AGIZA API, including /api (same backend as the customer app).
#
# Local development: leave it unset. The app then uses the computer running Metro
# (e.g. http://192.168.1.20:8000/api), which a physical phone on the same Wi-Fi can reach.
# Start Django with:  python manage.py runserver 0.0.0.0:8000
#
# Android emulator: 10.0.2.2 is the computer running the emulator, e.g.
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
#
# Physical Android phone over USB: run `adb reverse tcp:8000 tcp:8000` and use
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
#
# Release builds MUST use the public HTTPS API:
#   EXPO_PUBLIC_API_URL=https://api.agiza.co.tz/api
EXPO_PUBLIC_API_URL=

# EXPO_PUBLIC_SITE_URL: the public AGIZA website, used to open the seller terms (/vendor-terms)
# and your public store page (/store/<slug>). Optional: when empty the app tells the seller
# where to find them instead. Production: https://agiza.co.tz
EXPO_PUBLIC_SITE_URL=
