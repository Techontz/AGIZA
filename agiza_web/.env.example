# Django REST API base URL (…/api). Server-side only: never exposed to the browser.
DJANGO_API_URL=http://127.0.0.1:8000/api

# Public URL of this website: canonical links, sitemap, Open Graph.
# REQUIRED in production (the build refuses to guess it), e.g. https://agiza.co.tz
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Same value as the backend's STOREFRONT_SERVER_KEY: lets server-side rendering read the
# public catalogue without the per-visitor anonymous rate limit. Optional in development.
STOREFRONT_SERVER_KEY=

# Sign-in cookies get the Secure flag automatically in production builds (NODE_ENV=production).
# Leave this unset in production. Set it to "false" only to run a production build over plain http locally.
# SESSION_COOKIE_SECURE=false

# Optional store links shown on the website.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=
# Store links of the separate AGIZA Seller app, shown on /sell (this website is for customers only).
NEXT_PUBLIC_SELLER_ANDROID_APP_URL=
NEXT_PUBLIC_SELLER_IOS_APP_URL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=support@agiza.co.tz
