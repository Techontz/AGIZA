# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_SECURE_SSL_REDIRECT=true

# PostgreSQL
DATABASE_URL=postgres://agiza:password@localhost:5432/agiza
DB_CONN_MAX_AGE=60

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_LOGIN_RATE=10/min
# Trusted proxies in front of Django (Next.js server + nginx = 2). Required for correct client IPs.
DJANGO_NUM_PROXIES=2

# Files & logging
MEDIA_ROOT=/var/lib/agiza/media
LOG_LEVEL=INFO

# First Top Admin (python manage.py bootstrap_admin)
BOOTSTRAP_ADMIN_EMAIL=admin@agiza.co.tz
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_NAME=Admin User
