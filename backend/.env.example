# AGIZA backend configuration. Copy to backend/.env and fill in real values.
# Never commit backend/.env — it holds secrets.

# ---------------------------------------------------------------- Django core
# Production: DJANGO_SETTINGS_MODULE=config.settings.prod (the process environment, e.g. systemd/gunicorn).
# DJANGO_ENV=production makes the dev settings refuse to start, so a mis-set module fails loudly.
DJANGO_ENV=production
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
# Move the Django admin away from the default path (production refuses "admin/")
DJANGO_ADMIN_URL=change-me-admin/

# ---------------------------------------------------------------- Database
# MySQL 8.0+ (production; install requirements/mysql.txt; database utf8mb4 / utf8mb4_0900_ai_ci):
DATABASE_URL=mysql://agiza_user:password@localhost:3306/agiza_db
# PostgreSQL is also supported:
# DATABASE_URL=postgres://agiza:password@localhost:5432/agiza
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------- Auth & rate limits
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_LOGIN_RATE=10/min
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=1200/min
# Customer app (per account / per IP)
THROTTLE_CUSTOMER_RATE=600/min
THROTTLE_CUSTOMER_LOGIN_RATE=10/min
THROTTLE_OTP_RATE=5/min
THROTTLE_CHECKOUT_RATE=20/min
# Website orders placed without an account, per visitor IP
THROTTLE_GUEST_CHECKOUT_RATE=10/hour
# Writes only (reading is not limited by these)
THROTTLE_REVIEWS_RATE=20/hour
THROTTLE_RETURNS_RATE=10/hour
THROTTLE_UPLOADS_RATE=60/hour
THROTTLE_SUPPORT_RATE=30/min
THROTTLE_SELLER_APPLY_RATE=10/hour
# Customer app sessions (separate token types from staff)
CUSTOMER_JWT_ACCESS_MINUTES=30
CUSTOMER_JWT_REFRESH_DAYS=60
# Trusted proxies in front of Django (Next.js server + nginx = 2). Required for correct client IPs.
DJANGO_NUM_PROXIES=2

# ---------------------------------------------------------------- Files
# Local disk (default). For S3-compatible storage install django-storages[s3] and set:
#   DJANGO_FILE_STORAGE=storages.backends.s3.S3Storage
#   AWS_STORAGE_BUCKET_NAME=agiza-uploads  AWS_S3_ENDPOINT_URL=https://...  AWS_S3_REGION_NAME=...
#   AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...
MEDIA_ROOT=/var/lib/agiza/media
DJANGO_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# ---------------------------------------------------------------- Logging & error tracking
LOG_LEVEL=INFO
# Optional Sentry (install sentry-sdk). Personal data is not sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---------------------------------------------------------------- First Top Admin
# python manage.py bootstrap_admin
BOOTSTRAP_ADMIN_EMAIL=admin@agiza.co.tz
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_NAME=Admin User

# ---------------------------------------------------------------- Messaging channels (optional)
# Each channel stays disabled until its variables are set. Nothing is simulated.
# Email (campaigns): any SMTP server. In development you can use
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend to print emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Agiza <no-reply@agiza.co.tz>

# SMS via Beem Africa (https://beem.africa): campaigns and the customer app's verification codes.
# Required in production for customer registration and password reset. BEEM_SENDER_ID is the sender
# name registered with Beem (max 11 characters). With DJANGO_DEBUG=true and no SMS configured, codes
# are written to the server log instead.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=

# WhatsApp Cloud API (chat replies + campaigns; webhook: /api/chat/webhooks/whatsapp/)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Facebook Messenger (chat replies; webhook: /api/chat/webhooks/facebook/)
FACEBOOK_PAGE_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

# TikTok Business messaging (inbound webhook only: /api/chat/webhooks/tiktok/)
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------- Customer app payments & push
# Selcom Checkout (mobile money / card), as used by the previous AGIZA server. "Mobile money" is
# offered at checkout only when all five are set. Your server's public IP must be whitelisted by
# Selcom. SELCOM_CALLBACK_BASE_URL is this API's public BASE URL only (e.g. https://api.agiza.co.tz);
# /api/payments/selcom/webhook/ is appended. Do NOT reuse the old full callback URL
# (…/cargo/api/v1/invoice/selcom-callback/). Payments are always confirmed with Selcom's
# order-status API before being recorded; `manage.py check --deploy` warns about bad values.
SELCOM_VENDOR_CODE=
SELCOM_API_KEY=
SELCOM_SECRET_KEY=
SELCOM_BASE_PAYMENT_URL=https://apigw.selcommobile.com/v1
SELCOM_CALLBACK_BASE_URL=https://api.example.com
SELCOM_FALLBACK_BUYER_EMAIL=payments@agiza.co.tz
# Expo push notifications to the customer app (order updates, quotations, payments, support replies)
EXPO_PUSH_ENABLED=true

# Public website (agiza_web) server-to-server key: lets its server-side rendering read the
# public catalogue without the per-IP anonymous limit. Same value as agiza_web's
# STOREFRONT_SERVER_KEY. Generate a long random value; leave empty to disable.
STOREFRONT_SERVER_KEY=
